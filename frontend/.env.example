# Copy to .env (or .env.local) and adjust. Only VITE_* variables reach the browser,
# and they are baked in at build time, so rebuild after changing them.

# Where the GapVisor API lives. A path keeps requests same origin (CloudFront
# routing /api/* to the backend, or the Vite dev proxy locally). Use an absolute
# URL when the API is on another host, e.g. https://api.example.com/api/v1
# (that host must allow CORS with credentials for this origin).
VITE_API_BASE=/api/v1

# Optional. Health check used to choose live mode or demo mode. Defaults to
# /healthz on the same origin as VITE_API_BASE. When the API is unreachable the
# app runs in demo mode with the static sample data in src/data.
# VITE_API_HEALTH_URL=https://api.example.com/healthz

# Optional. Public base path when the app is served from a subdirectory,
# e.g. /gapvisor/. vite.config.ts reads it from the shell environment at build
# time (not from this file), e.g. VITE_BASE=/gapvisor/ npm run build. Defaults to /.

# Dev server only: where the Vite proxy forwards /api and /healthz.
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000
