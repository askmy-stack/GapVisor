# Provider binaries and module cache — regenerated by `terraform init`
.terraform/
.terraform.tfstate.lock.info

# State: never commit. Use the S3 backend in versions.tf instead.
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Real variable values — may contain account-specific or sensitive settings.
# terraform.tfvars.example IS committed.
terraform.tfvars
*.auto.tfvars
!terraform.tfvars.example

# Saved plans can contain secrets in plaintext
*.tfplan
